{"id":"tokyokanekijason","lines":[{"t":0.409,"end":4.592,"chars":[0],"who":"Rize","text":"Poor Yamori all that brawn and no brain...","de":"Armer Yamori — so viel Muskeln und kein Hirn…","orig":"scenes/tokyokanekijason/lines/01.mp3"},{"t":4.192,"end":9.342,"chars":[1],"who":"Jason","text":"*screaming* I'll swallow you all!","de":"*schreit* Ich verschlinge euch alle!","orig":"scenes/tokyokanekijason/lines/02.mp3"},{"t":9.099,"end":11.116,"chars":[1],"who":"Jason","text":"*getting thrown* RAUGH","de":"*wird geschleudert* RAUGH","orig":"scenes/tokyokanekijason/lines/03.mp3"},{"t":11.218,"end":13.751,"chars":[1],"who":"Jason","text":"*heavy breathing*","de":"*schweres Atmen*","orig":"scenes/tokyokanekijason/lines/04.mp3"},{"t":16.889,"end":17.822,"chars":[1],"who":"Jason","text":"*Grunt*","de":"*grunzt*","orig":"scenes/tokyokanekijason/lines/05.mp3"},{"t":18.862,"end":21.612,"chars":[1],"who":"Jason","text":"I'll kill you... I SWEAR IT!","de":"Ich töte dich… ich schwör's!","orig":"scenes/tokyokanekijason/lines/06.mp3"},{"t":21.668,"end":23.468,"chars":[1],"who":"Jason","text":"*Yelling*YAGHH","de":"*schreit* YAGHH","orig":"scenes/tokyokanekijason/lines/07.mp3"},{"t":24.074,"end":26.891,"chars":[1],"who":"Jason","text":"*Yelling* AGHH","de":"*schreit* AGHH","orig":"scenes/tokyokanekijason/lines/08.mp3"},{"t":27.722,"end":29.405,"chars":[1],"who":"Jason","text":"*Yelling* RYAGHH","de":"*schreit* RYAGHH","orig":"scenes/tokyokanekijason/lines/09.mp3"},{"t":32.468,"end":34.735,"chars":[1],"who":"Jason","text":"*Yelling*RGHHH","de":"*schreit* RGHHH","orig":"scenes/tokyokanekijason/lines/10.mp3"},{"t":41.446,"end":43.663,"chars":[2],"who":"Kaneki","text":"But I can do better","de":"Aber ich kann es besser.","orig":"scenes/tokyokanekijason/lines/11.mp3"},{"t":43.938,"end":46.021,"chars":[1],"who":"Jason","text":"*more yelling*","de":"*schreit weiter*","orig":"scenes/tokyokanekijason/lines/12.mp3"},{"t":46.729,"end":50.596,"chars":[1],"who":"Jason","text":"*more yelling 2x*","de":"*schreit nochmal*","orig":"scenes/tokyokanekijason/lines/13.mp3"},{"t":51.836,"end":57.419,"chars":[1],"who":"Jason","text":"*more yelling 3x*","de":"*schreit wieder*","orig":"scenes/tokyokanekijason/lines/14.mp3"},{"t":60.325,"end":63.892,"chars":[1],"who":"Jason","text":"*more yelling 4x*","de":"*schreit noch lauter*","orig":"scenes/tokyokanekijason/lines/15.mp3"},{"t":64.918,"end":68.001,"chars":[2],"who":"Kaneki","text":"What's one thousand minus seven?","de":"Was ist tausend minus sieben?","orig":"scenes/tokyokanekijason/lines/16.mp3"},{"t":65.074,"end":69.007,"chars":[1],"who":"Jason","text":"*grunts*","de":"*grunzt*","orig":"scenes/tokyokanekijason/lines/17.mp3"},{"t":69.063,"end":71.913,"chars":[2],"who":"Kaneki","text":"Remember you're the one who tried to eat me first...","de":"Denk dran — du wolltest mich zuerst fressen…","orig":"scenes/tokyokanekijason/lines/18.mp3"},{"t":69.213,"end":72.263,"chars":[1],"who":"Jason","text":"*more grunts*","de":"*grunzt weiter*","orig":"scenes/tokyokanekijason/lines/19.mp3"},{"t":72.184,"end":76.434,"chars":[2],"who":"Kaneki","text":"So you'll get what's coming to you...when I eat you instead.","de":"Also kriegst du, was dir zusteht… wenn ich stattdessen dich fresse.","orig":"scenes/tokyokanekijason/lines/20.mp3"},{"t":76.651,"end":79.251,"chars":[2],"who":"Kaneki","text":"*LARGE inhale*","de":"*tiefer Atemzug*","orig":"scenes/tokyokanekijason/lines/21.mp3"}]}