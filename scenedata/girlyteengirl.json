{"id":"girlyteengirl","lines":[{"t":0.784,"end":3.967,"chars":[0],"who":"Pearl","text":"*laughter*","de":"*Lachen*","orig":"scenes/girlyteengirl/lines/01.mp3"},{"t":4.952,"end":5.885,"chars":[0],"who":"Pearl","text":"Hello!?","de":"Hallo!?","orig":"scenes/girlyteengirl/lines/02.mp3"},{"t":5.901,"end":8.234,"chars":[1],"who":"Girly Teengirl","text":"Hi! I'm here for the slumber party","de":"Hi! Ich bin hier für die Übernachtungsparty","orig":"scenes/girlyteengirl/lines/03.mp3"},{"t":8.234,"end":9.401,"chars":[0],"who":"Pearl","text":"Do I know you!?","de":"Kenn ich dich!?","orig":"scenes/girlyteengirl/lines/04.mp3"},{"t":9.472,"end":11.072,"chars":[1],"who":"Girly Teengirl","text":"My name is... um","de":"Mein Name ist... ähm","orig":"scenes/girlyteengirl/lines/05.mp3"},{"t":11.423,"end":13.082,"chars":[1],"who":"Girly Teengirl","text":"Girly Teengirl?","de":"Girly Teengirl?","orig":"scenes/girlyteengirl/lines/06.mp3"},{"t":13.082,"end":14.632,"chars":[0],"who":"Pearl","text":"Uh huhhh! *aggressive*","de":"Ahaaa! *aggressiv*","orig":"scenes/girlyteengirl/lines/07.mp3"},{"t":14.689,"end":19.09,"chars":[1],"who":"Girly Teengirl","text":"Um, I just moved here from... um, Far Awayville!","de":"Ähm, ich bin gerade hergezogen aus... ähm Far Awayville!","orig":"scenes/girlyteengirl/lines/08.mp3"},{"t":19.09,"end":22.394,"chars":[0],"who":"Pearl","text":"I know it's you, SpongeBob SquarePants!","de":"Ich weiß, dass du das bist, SpongeBob Schwammkopf!","orig":"scenes/girlyteengirl/lines/09.mp3"},{"t":22.394,"end":24.594,"chars":[1],"who":"Girly Teengirl","text":"I don't know what you're talking about!","de":"Ich weiß nicht, wovon du redest!","orig":"scenes/girlyteengirl/lines/10.mp3"},{"t":24.673,"end":26.29,"chars":[1],"who":"Girly Teengirl","text":"*scream*","de":"*Schrei*","orig":"scenes/girlyteengirl/lines/11.mp3"},{"t":26.29,"end":29.223,"chars":[0],"who":"Pearl","text":"You were sent to spy on me by my dad!","de":"Mein Vater hat dich geschickt, um mich auszuspionieren!","orig":"scenes/girlyteengirl/lines/12.mp3"},{"t":29.365,"end":30.555,"chars":[0],"who":"Pearl","text":"Get him, girl!","de":"Schnapp ihn dir, Girl!","orig":"scenes/girlyteengirl/lines/13.mp3"},{"t":30.555,"end":32.288,"chars":[1],"who":"Girly Teengirl","text":"*scream*","de":"*Schrei*","orig":"scenes/girlyteengirl/lines/14.mp3"},{"t":32.546,"end":34.105,"chars":[1],"who":"Girly Teengirl","text":"*crying*","de":"*weint*","orig":"scenes/girlyteengirl/lines/15.mp3"},{"t":34.105,"end":36.972,"chars":[1],"who":"Girly Teengirl","text":"I am so going back to Far Awayville!","de":"Ich geh echt zurück nach Far Awayville!","orig":"scenes/girlyteengirl/lines/16.mp3"},{"t":38.066,"end":39.388,"chars":[2],"who":"Mr. Krabs","text":"Who the heck is that!?","de":"Wer zum Teufel ist das!?","orig":"scenes/girlyteengirl/lines/17.mp3"},{"t":39.388,"end":42.193,"chars":[3],"who":"SpongeBob","text":"I dunno! But she is uglyyyy!","de":"Keine Ahnung! Aber die ist hässlichhhh!","orig":"scenes/girlyteengirl/lines/18.mp3"}]}