rs.","orig":"scenes/yujitodohanami/lines/29.mp3"},{"t":97.633,"end":99.033,"chars":[1],"who":"Todo","text":"(Noises)","de":"(Geräusche)","orig":"scenes/yujitodohanami/lines/30.mp3"},{"t":101.217,"end":110.017,"chars":[1],"who":"Todo","text":"(noises)","de":"(Geräusche)","orig":"scenes/yujitodohanami/lines/31.mp3"},{"t":101.25,"end":109.967,"chars":[0],"who":"Yuji","text":"(noises)","de":"(Geräusche)","orig":"scenes/yujitodohanami/lines/32.mp3"},{"t":112.3,"end":117.917,"chars":[0],"who":"Yuji","text":"(Fighting noises)","de":"(Kampfgeräusche)","orig":"scenes/yujitodohanami/lines/33.mp3"},{"t":113.1,"end":115.283,"chars":[2],"who":"Hanami","text":"ah!","de":"ah!","orig":"scenes/yujitodohanami/lines/34.mp3"},{"t":117.217,"end":120.867,"chars":[1],"who":"Todo","text":"(Fighting noises)","de":"(Kampfgeräusche)","orig":"scenes/yujitodohanami/lines/35.mp3"},{"t":126.9,"end":130.5,"chars":[2],"who":"Hanami","text":"They're using that again?!","de":"Die nutzen das schon wieder?!","orig":"scenes/yujitodohanami/lines/36.mp3"},{"t":130.583,"end":134.283,"chars":[0],"who":"Yuji","text":"Black Flash!","de":"Black Flash!","orig":"scenes/yujitodohanami/lines/37.mp3"},{"t":134.367,"end":137.6,"chars":[0],"who":"Yuji","text":"Black Flash!","de":"Black Flash!","orig":"scenes/yujitodohanami/lines/38.mp3"},{"t":137.567,"end":139.334,"chars":[2],"who":"Hanami","text":"hah!","de":"hah!","orig":"scenes/yujitodohanami/lines/39.mp3"},{"t":139.4,"end":141.417,"chars":[2],"who":"Hanami","text":"Don't get cocky!","de":"Werdet nicht übermütig!","orig":"scenes/yujitodohanami/lines/40.mp3"},{"t":142.683,"end":149.016,"chars":[1],"who":"Todo","text":"Just 'cause I clap my hands doesn't always mean I'm activating my technique.","de":"Nur weil ich in die Hände klatsche, heißt das nicht immer, dass ich meine Technik aktiviere.","orig":"scenes/yujitodohanami/lines/41.mp3"},{"t":152.35,"end":154.667,"chars":[0],"who":"Yuji","text":"Black.. Flash","de":"Black... Flash","orig":"scenes/yujitodohanami/line