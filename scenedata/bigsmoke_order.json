{"id":"bigsmoke_order","lines":[{"t":2.3,"end":4.3,"chars":[3],"who":"Cashier","text":"Can I take your order, please?","de":"Kann ich Ihre Bestellung aufnehmen, bitte?","orig":"scenes/bigsmoke/lines/01.mp3"},{"t":4.3,"end":5.4,"chars":[1],"who":"Big Smoke","text":"Carl, what do you want?","de":"Carl, was willst du?","orig":"scenes/bigsmoke/lines/02.mp3"},{"t":5.4,"end":8.2,"chars":[1],"who":"Big Smoke","text":"You gotta eat to keep your strength up, man.","de":"Du musst essen, um bei Kräften zu bleiben, Mann.","orig":"scenes/bigsmoke/lines/03.mp3"},{"t":8.2,"end":10.1,"chars":[2],"who":"CJ","text":"Aye, I'll take a number 9.","de":"Ey, ich nehm 'ne Nummer 9.","orig":"scenes/bigsmoke/lines/04.mp3"},{"t":10.1,"end":11.9,"chars":[2],"who":"CJ","text":"Fat boy...","de":"Fettsack...","orig":"scenes/bigsmoke/lines/05.mp3"},{"t":11.9,"end":13.9,"chars":[4],"who":"Rider","text":"Give me number 9, just like his.","de":"Gib mir Nummer 9, genau wie seine.","orig":"scenes/bigsmoke/lines/06.mp3"},{"t":13.9,"end":16.2,"chars":[5],"who":"Sweet","text":"Uhh lemme get a number 6 with extra dip.","de":"Ähh, ich krieg 'ne Nummer 6 mit Extra-Dip.","orig":"scenes/bigsmoke/lines/07.mp3"},{"t":16.2,"end":19.14,"chars":[1],"who":"Big Smoke","text":"I'll have 2 number 9's","de":"Ich nehme 2 Nummer 9","orig":"scenes/bigsmoke/lines/08.mp3"},{"t":19.14,"end":21.4,"chars":[1],"who":"Big Smoke","text":"A number 9 large","de":"Eine Nummer 9, groß","orig":"scenes/bigsmoke/lines/09.mp3"},{"t":21.4,"end":24.5,"chars":[1],"who":"Big Smoke","text":"A number 6 with extra dip","de":"Eine Nummer 6 mit Extra-Dip","orig":"scenes/bigsmoke/lines/10.mp3"},{"t":24.5,"end":26,"chars":[1],"who":"Big Smoke","text":"A number 7","de":"Eine Nummer 7","orig":"scenes/bigsmoke/lines/11.mp3"},{"t":26,"end":28.53,"chars":[1],"who":"Big Smoke","text":"2 number 45's","de":"2 Nummer 45","orig":"scenes/bigsmoke/lines/12.mp3"},{"t":28.53,"end":30,"chars":[1],"who":"Big Smoke","text":"One with cheese","de":"Eine mit Käse","orig":"scenes/bigsmoke/lines/13.mp3"},{"t":30,"end":33.63,"chars":[1],"who":"Big Smoke","text":"And a large soda","de":"Und eine große Cola","orig":"scenes/bigsmoke/lines/14.mp3"}]}