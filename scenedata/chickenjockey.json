{"id":"chickenjockey","lines":[{"t":0,"end":3.58,"chars":[1],"who":"Steve","text":"You got this gar gar!","de":"Du schaffst das, Kleiner!","orig":"scenes/chickenjockey/lines/01.mp3"},{"t":3.58,"end":5.92,"chars":[1],"who":"Steve","text":"Reach down DEEP","de":"Grab tief rein","orig":"scenes/chickenjockey/lines/02.mp3"},{"t":5.92,"end":8.73,"chars":[1],"who":"Steve","text":"I have no idea","de":"Ich hab keine Ahnung","orig":"scenes/chickenjockey/lines/03.mp3"},{"t":8.73,"end":9.87,"chars":[2],"who":"Garret","text":"What's going on Steve.","de":"Was geht hier ab, Steve.","orig":"scenes/chickenjockey/lines/04.mp3"},{"t":9.87,"end":12.93,"chars":[1],"who":"Steve","text":"It's some kind of sadistic Vindicator fight club.","de":"Das ist irgend so ein sadistischer Vindicator-Kampfclub.","orig":"scenes/chickenjockey/lines/05.mp3"},{"t":12.93,"end":15.12,"chars":[1],"who":"Steve","text":"I've heard of these but i've never seen one.","de":"Ich hab von sowas gehört, aber noch nie eins gesehen.","orig":"scenes/chickenjockey/lines/06.mp3"},{"t":15.12,"end":17.19,"chars":[2],"who":"Garret","text":"They want me to fight the chicken?","de":"Die wollen, dass ich gegen das Huhn kämpfe?","orig":"scenes/chickenjockey/lines/07.mp3"},{"t":17.19,"end":37.87,"chars":[1],"who":"Steve","text":"It's a fight to the death kid!","de":"Das ist ein Kampf auf Leben und Tod, Kleiner!","orig":"scenes/chickenjockey/lines/08.mp3"},{"t":37.87,"end":43.01,"chars":[3,2],"who":"Chicken Jockey+Garret","text":"hehehehe bok (baby noises) RAAAAH (Garett) AH!","de":"hehehehe bok (Baby-Geräusche) RAAAAH (Garret) AH!","orig":"scenes/chickenjockey/lines/09.mp3"},{"t":43.01,"end":44.57,"chars":[1],"who":"Steve","text":"CHICKEN JOCKEY!","de":"CHICKEN JOCKEY!","orig":"scenes/chickenjockey/lines/10.mp3"},{"t":44.57,"end":49.09,"chars":[3,2],"who":"Chicken Jockey+Garret","text":"(Chicken Jockey Noises) (Garett) AH AH!","de":"(Chicken-Jockey-Geräusche) (Garret) AH AH!","orig":"scenes/chickenjockey/lines/11.mp3"}]}