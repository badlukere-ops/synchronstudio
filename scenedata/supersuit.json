{"id":"supersuit","lines":[{"t":9.564,"end":10.687,"chars":[0],"who":"Frozone","text":"Hoooneyyyy...!","de":"Schääätziii…!","orig":"scenes/supersuit/lines/01.mp3"},{"t":10.635,"end":11.419,"chars":[1],"who":"Honey","text":"Whaaaat?","de":"Waaaaas?","orig":"scenes/supersuit/lines/02.mp3"},{"t":11.366,"end":13.012,"chars":[0],"who":"Frozone","text":"Where's my super suit...?","de":"Wo ist mein Superanzug…?","orig":"scenes/supersuit/lines/03.mp3"},{"t":12.943,"end":13.753,"chars":[1],"who":"Honey","text":"Whaaaat?","de":"Waaaaas?","orig":"scenes/supersuit/lines/04.mp3"},{"t":13.68,"end":17.102,"chars":[0],"who":"Frozone","text":"WHERE... IS... MY... SUPER SUIT!?","de":"WO… IST… MEIN… SUPERANZUG!?","orig":"scenes/supersuit/lines/05.mp3"},{"t":17.039,"end":19.233,"chars":[1],"who":"Honey","text":"I uhhhhh... put it away!","de":"Ich ähhhh… hab ihn weggepackt!","orig":"scenes/supersuit/lines/06.mp3"},{"t":19.157,"end":20.254,"chars":[0],"who":"Frozone","text":"WHEEEEERE?","de":"WOOOO?","orig":"scenes/supersuit/lines/07.mp3"},{"t":20.2,"end":22.551,"chars":[1],"who":"Honey","text":"Whyyyy do you neeeeeed to know?","de":"Waruuum musst du daaas wissen?","orig":"scenes/supersuit/lines/08.mp3"},{"t":22.409,"end":23.167,"chars":[0],"who":"Frozone","text":"I need it!","de":"Ich brauch ihn!","orig":"scenes/supersuit/lines/09.mp3"},{"t":23.099,"end":28.977,"chars":[1],"who":"Honey","text":"Uh-uh! Don't you think about runnin' off to doin' no Darin' Do - we've been planning this dinner for two months!","de":"Äh-äh! Denk gar nicht dran, wieder irgendwelchen Heldentaten hinterherzujagen — wir planen dieses Dinner seit zwei Monaten!","orig":"scenes/supersuit/lines/10.mp3"},{"t":28.695,"end":30.419,"chars":[0],"who":"Frozone","text":"The public is in danger!","de":"Die Leute sind in Gefahr!","orig":"scenes/supersuit/lines/11.mp3"},{"t":30.365,"end":32.272,"chars":[1],"who":"Honey","text":"My EVENING'S in danger!","de":"Mein ABEND ist in Gefahr!","orig":"scenes/supersuit/lines/12.mp3"},{"t":32.199,"end":35.778,"chars":[0],"who":"Frozone","text":"YOU TELL ME WHERE MY SUIT IS, WOMAN! WE ARE TALKING ABOUT THE GREATER GOOD!!","de":"SAG MIR WO MEIN ANZUG IST, FRAU! ES GEHT UM DAS GRÖSSERE GANZE!!","orig":"scenes/supersuit/lines/13.mp3"},{"t":35.723,"end":41.183,"chars":[1],"who":"Honey","text":"Greater good? I am your WIFE! I'm the greatest GOOD you are EVER gonna get!!!","de":"Größeres Ganzes? Ich bin deine FRAU! Ich bin das beste GUTE, das du JE kriegen wirst!!!","orig":"scenes/supersuit/lines/14.mp3"},{"t":40.039,"end":40.222,"chars":[0],"who":"Frozone","text":"*ugh*","de":"*ächz*","orig":"scenes/supersuit/lines/15.mp3"}]}