{"id":"spongebob_krab","lines":[{"t":0,"end":1.79,"chars":[1],"who":"Spongebob","text":"All you have to do is answer the phone!","de":"Du musst nur ans Telefon gehen!","orig":"scenes/spongebob/lines/01.mp3"},{"t":1.79,"end":7.08,"chars":[2],"who":"Patrick","text":"Aye aye, Cap-n!","de":"Aye aye, Käpt'n!","orig":"scenes/spongebob/lines/02.mp3"},{"t":7.08,"end":8.81,"chars":[3],"who":"Phone","text":"Is this the Krusty Krab?","de":"Ist da die Krosse Krabbe?","orig":"scenes/spongebob/lines/03.mp3"},{"t":8.81,"end":13.17,"chars":[2],"who":"Patrick","text":"No, this is Patrick","de":"Nein, hier ist Patrick","orig":"scenes/spongebob/lines/04.mp3"},{"t":13.17,"end":14.82,"chars":[3],"who":"Phone","text":"Is this the Krusty Krab?","de":"Ist da die Krosse Krabbe?","orig":"scenes/spongebob/lines/05.mp3"},{"t":14.82,"end":21.66,"chars":[2],"who":"Patrick","text":"Noo, this is Patrick!","de":"Neiin, hier ist Patrick!","orig":"scenes/spongebob/lines/06.mp3"},{"t":21.66,"end":23.33,"chars":[3],"who":"Phone","text":"Is this the Krusty Krab?","de":"Ist da die Krosse Krabbe?","orig":"scenes/spongebob/lines/07.mp3"},{"t":23.33,"end":29.63,"chars":[2],"who":"Patrick","text":"No! This is Patrick! [Grunt] I'm not a Krusty Krab.","de":"Nein! Hier ist Patrick! [Grunzen] Ich bin keine Krosse Krabbe.","orig":"scenes/spongebob/lines/08.mp3"},{"t":29.63,"end":32.3,"chars":[1],"who":"Spongebob","text":"Uhh, Patrick, that's the name of the restaurant.","de":"Ähh, Patrick... so heißt das Restaurant.","orig":"scenes/spongebob/lines/09.mp3"},{"t":32.3,"end":35.78,"chars":[2],"who":"Patrick","text":"Huh? [Anger sound] Fish paste!","de":"Häh? [Wut-Geräusch] Fischpaste!","orig":"scenes/spongebob/lines/10.mp3"}]}