{"id":"opensesame","lines":[{"t":5.853,"end":9.969,"chars":[0],"who":"Patrick","text":"“okay SpongeBob you could be Dirty Dan I just want to be Patrick”","de":"„okay SpongeBob du kannst Dirty Dan sein ich will einfach nur Patrick sein“","orig":"scenes/opensesame/lines/01.mp3"},{"t":10.019,"end":12.633999999999999,"chars":[1],"who":"SpongeBob","text":"“let's get out of here before Sandy wakes up”","de":"„lass uns hier raus bevor Sandy aufwacht“","orig":"scenes/opensesame/lines/02.mp3"},{"t":12.684,"end":13.678999999999998,"chars":[0],"who":"Patrick","text":"“(Running Sound)”","de":"„(Renn-Geräusch)“","orig":"scenes/opensesame/lines/03.mp3"},{"t":13.729,"end":17.166999999999998,"chars":[1],"who":"SpongeBob","text":"“(Heavy Breathing)”","de":"„(Schweres Atmen)“","orig":"scenes/opensesame/lines/04.mp3"},{"t":17.217,"end":21.142,"chars":[1],"who":"SpongeBob","text":"“(Struggling sound)”","de":"„(Keuch-Geräusch)“","orig":"scenes/opensesame/lines/05.mp3"},{"t":21.192,"end":21.942,"chars":[0],"who":"Patrick","text":"“Ouch”","de":"„Autsch“","orig":"scenes/opensesame/lines/06.mp3"},{"t":21.992,"end":25.758,"chars":[1],"who":"SpongeBob","text":"“sorry Patrick but the door is slippery it's frozen shut”","de":"„tut mir leid Patrick aber die Tür ist glitschig sie ist zugefroren“","orig":"scenes/opensesame/lines/07.mp3"},{"t":25.808,"end":28.009999999999998,"chars":[0],"who":"Patrick","text":"“ let me have a try”","de":"„ lass mich mal versuchen“","orig":"scenes/opensesame/lines/08.mp3"},{"t":28.386,"end":29.951999999999998,"chars":[0],"who":"Patrick","text":"“Tugh Tugh”","de":"„Tugh Tugh“","orig":"scenes/opensesame/lines/09.mp3"},{"t":30.002,"end":32.443000000000005,"chars":[0],"who":"Patrick","text":"“open sesame”","de":"„Sesam öffne dich“","orig":"scenes/opensesame/lines/10.mp3"},{"t":32.493,"end":34.283333000000006,"chars":[0],"who":"Patrick","text":"“well I've done all I can do”","de":"„naja ich hab alles getan was ich konnte“","orig":"scenes/opensesame/lines/11.mp3"}]}