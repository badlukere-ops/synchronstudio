{"id":"ghostrabbit","lines":[{"t":3.058,"end":4.491,"chars":[1],"who":"Satsuki","text":"You are pathethic","de":"Du bist erbärmlich","orig":"scenes/ghostrabbit/lines/01.mp3"},{"t":4.541,"end":8.657,"chars":[2],"who":"Mio","text":"When he died I was so sad that I would never hear that voice again","de":"Als er starb, war ich so traurig, dass ich diese Stimme nie wieder hören würde","orig":"scenes/ghostrabbit/lines/02.mp3"},{"t":8.707,"end":9.558,"chars":[2],"who":"Mio","text":"His laugh","de":"Sein Lachen","orig":"scenes/ghostrabbit/lines/03.mp3"},{"t":9.608,"end":11.778,"chars":[3],"who":"Rabbit","text":"*Hehe* *Hehe*","de":"*Hihi* *Hihi*","orig":"scenes/ghostrabbit/lines/04.mp3"},{"t":11.924,"end":13.974,"chars":[2],"who":"Mio","text":"His funny little requests","de":"Seine lustigen kleinen Bitten","orig":"scenes/ghostrabbit/lines/05.mp3"},{"t":14.024,"end":15.324,"chars":[3],"who":"Rabbit","text":"Touch me","de":"Fass mich an","orig":"scenes/ghostrabbit/lines/06.mp3"},{"t":15.374,"end":16.481,"chars":[2],"who":"Mio","text":"His reprimands","de":"Seine Ermahnungen","orig":"scenes/ghostrabbit/lines/07.mp3"},{"t":16.531,"end":17.524,"chars":[3],"who":"Rabbit","text":"Touch me harder","de":"Fass mich fester an","orig":"scenes/ghostrabbit/lines/08.mp3"},{"t":17.574,"end":20.36,"chars":[2],"who":"Mio","text":"Shirotabi please forgive me for bringing you back to life","de":"Shirotabi, verzeih mir bitte, dass ich dich zurückgeholt habe","orig":"scenes/ghostrabbit/lines/09.mp3"},{"t":20.41,"end":22.624,"chars":[2],"who":"Mio","text":"I know now that it could never work between us","de":"Ich weiß jetzt: Zwischen uns kann es nie klappen","orig":"scenes/ghostrabbit/lines/10.mp3"},{"t":22.674,"end":26.554,"chars":[2],"who":"Mio","text":"As much as we want it to it could never be","de":"So sehr wir es auch wollen — es geht einfach nicht","orig":"scenes/ghostrabbit/lines/11.mp3"},{"t":27.674,"end":29.724,"chars":[2],"who":"Mio","text":"Not because your a rabbit","de":"Nicht weil du ein Hase bist","orig":"scenes/ghostrabbit/lines/12.mp3"},{"t":29.774,"end":31.854,"chars":[2],"who":"Mio","text":"But because your black","de":"Sondern weil du schwarz bist","orig":"scenes/ghostrabbit/lines/13.mp3"}]}