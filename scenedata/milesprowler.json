{"id":"milesprowler","lines":[{"t":0.343,"end":1.443,"chars":[0],"who":"Miles Morales","text":"What?","de":"Was?","orig":"scenes/milesprowler/lines/01.mp3"},{"t":2,"end":6,"chars":[1],"who":"Prowler","text":"Your father — you said he's still alive.","de":"Dein Vater — du sagtest, er sei noch am Leben.","orig":"scenes/milesprowler/lines/02.mp3"},{"t":6.49,"end":8.09,"chars":[0],"who":"Miles Morales","text":"Yeah?","de":"Ja?","orig":"scenes/milesprowler/lines/03.mp3"},{"t":10.1,"end":11.2,"chars":[1],"who":"Prowler","text":"Hmm.","de":"Hmm.","orig":"scenes/milesprowler/lines/04.mp3"},{"t":12.38,"end":14.08,"chars":[0],"who":"Miles Morales","text":"Who are you?","de":"Wer bist du?","orig":"scenes/milesprowler/lines/05.mp3"},{"t":20.83,"end":22.53,"chars":[0],"who":"Miles Morales","text":"(soft exhale)","de":"(leichtes Ausatmen)","orig":"scenes/milesprowler/lines/06.mp3"},{"t":22.79,"end":25.79,"chars":[1],"who":"Prowler","text":"I'm Miles Morales.","de":"Ich bin Miles Morales.","orig":"scenes/milesprowler/lines/07.mp3"},{"t":26.72,"end":31.12,"chars":[1],"who":"Prowler","text":"But you... you can call me the Prowler.","de":"Aber du... du darfst mich den Prowler nennen.","orig":"scenes/milesprowler/lines/08.mp3"},{"t":32.86,"end":34.76,"chars":[0],"who":"Miles Morales","text":"If I don't make it home...","de":"Wenn ich nicht nach Hause komme...","orig":"scenes/milesprowler/lines/09.mp3"},{"t":36.36,"end":37.955,"chars":[0],"who":"Miles Morales","text":"...then our dad gets killed.","de":"...dann wird unser Dad getötet.","orig":"scenes/milesprowler/lines/10.mp3"},{"t":37.39,"end":39.19,"chars":[1],"who":"Prowler","text":"Your dad.","de":"Dein Dad.","orig":"scenes/milesprowler/lines/11.mp3"},{"t":39.27,"end":43.27,"chars":[0],"who":"Miles Morales","text":"(soft exhale)... please.","de":"(leichtes Ausatmen)... bitte.","orig":"scenes/milesprowler/lines/12.mp3"},{"t":44.552,"end":46.152,"chars":[0],"who":"Miles Morales","text":"You have to let me go.","de":"Du musst mich gehen lassen.","orig":"scenes/milesprowler/lines/13.mp3"},{"t":51.539,"end":53.339,"chars":[1],"who":"Prowler","text":"Why would I do that?","de":"Warum sollte ich das tun?","orig":"scenes/milesprowler/lines/14.mp3"}]}